<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy the test assets next to the .exe, so they are also found when the app is started from Visual Studio (F5) -->
    <None Update="assets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
